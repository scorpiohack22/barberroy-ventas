    "@remotion/studio": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
